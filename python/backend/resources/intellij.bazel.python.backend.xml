<idea-plugin>
  <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
  <dependencies>
    <module name="intellij.bazel.commons"/>
    <module name="intellij.bazel.connector"/>
    <module name="intellij.bazel.importer"/>
    <module name="intellij.bazel.python.common"/>
    <module name="intellij.platform.analysis"/>
    <module name="intellij.platform.backend"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.ide"/>
    <module name="intellij.platform.ide.core"/>
    <module name="intellij.platform.indexing"/>
    <module name="intellij.platform.kernel.backend"/>
    <module name="intellij.platform.lang.core"/>
    <module name="intellij.platform.lang.impl"/>
    <module name="intellij.platform.projectModel"/>
    <module name="intellij.platform.projectModel.impl"/>
    <module name="intellij.platform.rpc.backend"/>
    <module name="intellij.python.community.impl"/>
    <module name="intellij.python.community.services.systemPython"/>
    <module name="intellij.python.pyproject"/>
    <module name="intellij.python.sdk.backend"/>
  </dependencies>
  <!-- endregion -->

  <resource-bundle>messages.BazelPythonBackendBundle</resource-bundle>

  <extensionPoints>
    <extensionPoint
      dynamic="true"
      interface="com.intellij.bazel.python.backend.PythonSynonymProvider"
      qualifiedName="org.jetbrains.bazel.python.synonymProvider"
    />
  </extensionPoints>

  <extensions defaultExtensionNs="Pythonid">
    <importResolver implementation="com.intellij.bazel.python.backend.BazelPyImportResolver" />
    <canonicalPathProvider implementation="com.intellij.bazel.python.backend.BazelPyCanonicalPathProvider" />
    <importCandidateProvider implementation="com.intellij.bazel.python.backend.BazelPyImportCandidateProvider" />
    <pythonPackageManagerProvider implementation="com.intellij.bazel.python.backend.BazelPythonPackageManagerProvider"/>
  </extensions>

  <extensions defaultExtensionNs="com.intellij">
    <completion.contributor language="Python" implementationClass="com.intellij.bazel.python.backend.BazelPythonImportCompletionContributor"/>
    <moduleRendererFactory implementation="com.intellij.bazel.python.backend.BazelPythonModuleRendererFactory" order="before platform"/>
  </extensions>

  <extensions defaultExtensionNs="org.jetbrains.bazel">
    <indexAdditionalFilesContributor implementation="com.intellij.bazel.python.backend.PythonIndexAdditionalFilesContributor"/>
    <syncWorkspaceImporter implementation="com.intellij.bazel.python.backend.BazelPythonWorkspaceImporter"/>
    <languagePlugin implementation="com.intellij.bazel.python.backend.sync.PythonLanguagePlugin"/>
    <workspaceTypeContributor implementation="com.intellij.bazel.python.backend.sync.PythonWorkspaceTypeContributor"/>
  </extensions>
</idea-plugin>
