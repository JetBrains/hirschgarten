<idea-plugin>
  <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
  <dependencies>
    <plugin id="com.intellij.modules.python"/>
    <module name="intellij.bazel.commons"/>
    <module name="intellij.bazel.connector"/>
    <module name="intellij.bazel.core"/>
    <module name="intellij.bazel.importer"/>
    <module name="intellij.platform.analysis"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.debugger"/>
    <module name="intellij.platform.debugger.impl"/>
    <module name="intellij.platform.execution"/>
    <module name="intellij.platform.execution.impl"/>
    <module name="intellij.platform.ide"/>
    <module name="intellij.platform.ide.core"/>
    <module name="intellij.platform.ide.core.impl"/>
    <module name="intellij.platform.lang"/>
    <module name="intellij.platform.lang.core"/>
    <module name="intellij.platform.lang.impl"/>
    <module name="intellij.platform.projectModel"/>
    <module name="intellij.platform.smRunner"/>
    <module name="intellij.platform.testRunner"/>
    <module name="intellij.python.community.impl"/>
    <module name="intellij.python.community.services.systemPython"/>
    <module name="intellij.python.pydev"/>
    <module name="intellij.python.sdk.backend"/>
  </dependencies>
  <!-- endregion -->

  <extensions defaultExtensionNs="com.intellij">
    <programRunner implementation="org.jetbrains.bazel.python.run.PythonBspDebugRunner" />
    <runConfigurationProducer implementation="org.jetbrains.bazel.python.gutter.BazelPyRunConfigurationProducer"/>
  </extensions>

  <extensions defaultExtensionNs="org.jetbrains.bazel">
    <targetKindProvider implementation="org.jetbrains.bazel.python.lang.PythonBazelRules" />
    <languageClassProvider implementation="org.jetbrains.bazel.python.lang.PythonLanguageClassProvider" />
    <runHandlerProvider
      id="PythonBazelRunHandlerProvider"
      implementation="org.jetbrains.bazel.python.run.PythonBazelRunHandler$Provider"
    />
    <runHandlerProvider
      id="PythonBazelTestHandlerProvider"
      implementation="org.jetbrains.bazel.python.run.PythonBazelTestHandler$Provider"
    />
  </extensions>
</idea-plugin>
