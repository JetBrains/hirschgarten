<idea-plugin visibility="public">
  <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
  <dependencies>
    <module name="intellij.bazel.commons"/>
    <module name="intellij.bazel.projectview"/>
    <module name="intellij.bazel.protobuf"/>
    <module name="intellij.libraries.bazel.aspect.sdk"/>
    <module name="intellij.libraries.caffeine"/>
    <module name="intellij.libraries.fastutil"/>
    <module name="intellij.libraries.grpc"/>
    <module name="intellij.libraries.gson"/>
    <module name="intellij.libraries.guava"/>
    <module name="intellij.libraries.hash4j"/>
    <module name="intellij.libraries.jackson"/>
    <module name="intellij.libraries.jackson.databind"/>
    <module name="intellij.libraries.jackson.dataformat.xml"/>
    <module name="intellij.libraries.jackson.module.kotlin"/>
    <module name="intellij.libraries.jediterm.core"/>
    <module name="intellij.libraries.jetbrains.annotations"/>
    <module name="intellij.libraries.kotlinx.coroutines.core"/>
    <module name="intellij.libraries.kotlinx.serialization.core"/>
    <module name="intellij.libraries.kotlinx.serialization.json"/>
    <module name="intellij.libraries.kryo5"/>
    <module name="intellij.libraries.mvstore"/>
    <module name="intellij.libraries.protobuf"/>
    <module name="intellij.libraries.velocity"/>
    <module name="intellij.platform.analysis"/>
    <module name="intellij.platform.backend"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.diagnostic.telemetry"/>
    <module name="intellij.platform.externalSystem"/>
    <module name="intellij.platform.externalSystem.impl"/>
    <module name="intellij.platform.ide"/>
    <module name="intellij.platform.ide.core"/>
    <module name="intellij.platform.ide.impl"/>
    <module name="intellij.platform.ide.progress"/>
    <module name="intellij.platform.lang"/>
    <module name="intellij.platform.lang.core"/>
    <module name="intellij.platform.lang.impl"/>
    <module name="intellij.platform.projectModel"/>
    <module name="intellij.platform.projectModel.impl"/>
    <module name="intellij.platform.statistics"/>
    <module name="intellij.platform.util.coroutines"/>
    <module name="intellij.platform.util.ex"/>
    <module name="intellij.platform.workspace.jps"/>
  </dependencies>
  <!-- endregion -->

  <extensionPoints>
    <extensionPoint qualifiedName="org.jetbrains.bazel.bazelProcessLauncherProvider"
                    interface="org.jetbrains.bazel.bazelrunner.BazelProcessLauncherProvider"
                    dynamic="true"
    />
    <extensionPoint qualifiedName="org.jetbrains.bazel.bepEventHandlerProvider"
                    interface="org.jetbrains.bazel.server.bep.BepEventHandlerProvider"
                    dynamic="true"
    />
    <extensionPoint qualifiedName="org.jetbrains.bazel.testLocationHintProvider"
                    interface="org.jetbrains.bazel.util.BazelTestLocationHintProvider"
                    dynamic="true"
    />
    <extensionPoint
      dynamic="true"
      interface="org.jetbrains.bazel.sync.ProjectSyncHook"
      qualifiedName="org.jetbrains.bazel.projectSyncHook"
    />
    <extensionPoint
      dynamic="true"
      interface="org.jetbrains.bazel.sync.ProjectPreSyncHook"
      qualifiedName="org.jetbrains.bazel.projectPreSyncHook"
    />
    <extensionPoint
      dynamic="true"
      interface="org.jetbrains.bazel.sync.ProjectPostSyncHook"
      qualifiedName="org.jetbrains.bazel.projectPostSyncHook"
    />
    <!-- dynamic="false" because of the caching in the init block of TargetKindService  -->
    <extensionPoint
      dynamic="false"
      interface="org.jetbrains.bazel.sync.workspace.targetKind.TargetKindProvider"
      qualifiedName="org.jetbrains.bazel.targetKindProvider"
    />
    <extensionPoint
      dynamic="true"
      interface="org.jetbrains.bazel.sync.workspace.languages.LanguagePlugin"
      qualifiedName="org.jetbrains.bazel.languagePlugin"
    />
    <extensionPoint
      dynamic="true"
      interface="org.jetbrains.bazel.sync.workspace.importer.BazelWorkspaceImporter"
      qualifiedName="org.jetbrains.bazel.syncWorkspaceImporter"
    />
    <extensionPoint qualifiedName="org.jetbrains.bazel.indexAdditionalFilesContributor"
                    interface="org.jetbrains.bazel.workspace.indexAdditionalFiles.IndexAdditionalFilesContributor"
                    dynamic="true"
    />
    <extensionPoint qualifiedName="org.jetbrains.bazel.workspaceTypeContributor"
                    interface="org.jetbrains.bazel.sync.workspace.persistence.WorkspaceTypeContributor"
                    dynamic="false"
    />
    <extensionPoint qualifiedName="org.jetbrains.bazel.bazelRuleSetProvider"
                    interface="org.jetbrains.bazel.util.BazelRuleSetProvider"
                    dynamic="true"
    />
  </extensionPoints>

  <extensions defaultExtensionNs="org.jetbrains.bazel">
    <projectSyncHook implementation="org.jetbrains.bazel.sync.hooks.PathSyncHook"/>
    <targetKindProvider implementation="org.jetbrains.bazel.sync.workspace.targetKind.GenericBazelRules" order="last"/>

    <workspaceTypeContributor implementation="org.jetbrains.bazel.sync.workspace.persistence.DefaultWorkspaceTypeContributor"/>
  </extensions>

  <extensions defaultExtensionNs="com.intellij">
    <workspaceModel.fileIndexContributor
      implementation="org.jetbrains.bazel.workspace.BazelProjectDirectoriesWorkspaceFileIndexContributor"
    />
    <projectService serviceInterface="org.jetbrains.bazel.sync.workspace.persistence.WorkspaceSnapshotService"
                    serviceImplementation="org.jetbrains.bazel.sync.workspace.persistence.mvstore.DefaultWorkspaceSnapshotService"/>
    <projectService serviceInterface="org.jetbrains.bazel.sync.ProjectSyncService"
                    serviceImplementation="org.jetbrains.bazel.sync.DefaultProjectSyncService"/>

    <statistics.counterUsagesCollector implementationClass="org.jetbrains.bazel.fus.BazelBuildMetricsCollector"/>
    <statistics.counterUsagesCollector implementationClass="org.jetbrains.bazel.fus.BazelSyncCollector"/>
    <statistics.validation.customValidationRule implementation="org.jetbrains.bazel.fus.BazelSyncLanguageValidationRule"/>
  </extensions>
</idea-plugin>
