// The grammar of Starlark: https://github.com/bazelbuild/starlark/blob/master/spec.md
{
  generate=[psi="no" names="short"]
  generateTokens=true

  parserClass="org.jetbrains.bazel.languages.starlark.parser.generated._StarlarkParser"
  parserUtilClass="org.jetbrains.bazel.languages.starlark.parser.StarlarkParserUtil"
  elementTypeHolderClass="org.jetbrains.bazel.languages.starlark.parser.generated.StarlarkTokenTypes"
  tokenTypeClass="org.jetbrains.bazel.languages.starlark.elements.StarlarkTokenType"
  elementTypeClass="org.jetbrains.bazel.languages.starlark.elements.StarlarkElementType"
  // These tokens are not listed in "… expected" error messages, so an error does not list every operator.
  consumeTokenMethod(".*_start|.*_tail|assignment_suffix|aug_operator|comparison_operator|not_in_operator|not_in_keyword|conditional_expression|qualified_reference_expression|call_expression|subscription_expression")="consumeTokenFast"
  // A name alone is a complete argument or parameter, so a message does not list the '=' after it.
  consumeTokenMethod("keyword_prefix|keyword_equals")="consumeTokenFast"
  // A message shows a named rule as one item, as "expression expected", not as its start tokens.
  name("single_expression|expression|or_level|not_level|bitwise_or_level|unary_level|list_item|starred_operand|comprehension_condition")="expression"
  name("statement_or_break|statement|simple_statement|suite|inline_statement_list")="statement"
  name("argument_item|argument")="argument"
  name("parameter_item|parameter")="parameter"
  name("load_filename_item|load_item|load_string|string_literal_expression")="string"
  name("dict_item|dict_entry")="dict entry"

  tokens=[
    SPACE='SPACE'
    TAB='TAB'
    LINE_CONTINUATION='LINE_CONTINUATION'
    LINE_BREAK='LINE_BREAK'

    INDENT='indent'
    DEDENT='dedent'
    INCONSISTENT_DEDENT='inconsistent dedent'
    STATEMENT_BREAK='end of statement'

    COMMENT='comment'

    STRING='string'
    BYTES='bytes'
    INT='integer'
    FLOAT='float'

    AND_KEYWORD='and'
    BREAK_KEYWORD='break'
    CONTINUE_KEYWORD='continue'
    DEF_KEYWORD='def'
    ELIF_KEYWORD='elif'
    ELSE_KEYWORD='else'
    FOR_KEYWORD='for'
    IF_KEYWORD='if'
    IN_KEYWORD='in'
    LAMBDA_KEYWORD='lambda'
    LOAD_KEYWORD='load'
    NOT_KEYWORD='not'
    OR_KEYWORD='or'
    PASS_KEYWORD='pass'
    RETURN_KEYWORD='return'
    NONE_KEYWORD='None'
    TRUE_KEYWORD='True'
    FALSE_KEYWORD='False'

    // Python keywords that Starlark reserves. The lexer makes tokens of them, and StarlarkUnsupportedPythonSyntaxInspection reports them.
    AS_KEYWORD='as'
    ASSERT_KEYWORD='assert'
    ASYNC_KEYWORD='async'
    AWAIT_KEYWORD='await'
    CLASS_KEYWORD='class'
    DEL_KEYWORD='del'
    EXCEPT_KEYWORD='except'
    FINALLY_KEYWORD='finally'
    FROM_KEYWORD='from'
    GLOBAL_KEYWORD='global'
    IMPORT_KEYWORD='import'
    IS_KEYWORD='is'
    NONLOCAL_KEYWORD='nonlocal'
    RAISE_KEYWORD='raise'
    TRY_KEYWORD='try'
    WHILE_KEYWORD='while'
    WITH_KEYWORD='with'
    YIELD_KEYWORD='yield'

    IDENTIFIER='identifier'

    PLUS='+'
    MINUS='-'
    MULT='*'
    DIV='/'
    FLOORDIV='//'
    PERC='%'
    EXP='**'
    TILDE='~'
    AND='&'
    OR='|'
    XOR='^'
    LTLT='<<'
    GTGT='>>'
    DOT='.'
    COMMA=','
    EQ='='
    SEMICOLON=';'
    COLON=':'
    LPAR='('
    RPAR=')'
    LBRACKET='['
    RBRACKET=']'
    LBRACE='{'
    RBRACE='}'
    LT='<'
    GT='>'
    LE='<='
    GE='>='
    EQEQ='=='
    NE='!='
    PLUSEQ='+='
    MINUSEQ='-='
    MULTEQ='*='
    DIVEQ='/='
    FLOORDIVEQ='//='
    PERCEQ='%='
    ANDEQ='&='
    OREQ='|='
    XOREQ='^='
    LTLTEQ='<<='
    GTGTEQ='>>='
  ]
}

// File and statements

starlark_file ::= <<withoutBracketGroups>> file_item*
private file_item ::= !<<eof>> statement_or_break { pin=1 recoverWhile=statement_recover }
private block_item ::= !(DEDENT | <<eof>>) statement_or_break { pin=1 recoverWhile=statement_recover }
private statement_or_break ::= STATEMENT_BREAK | statement | unexpected_block | <<unexpectedStatementToken>>
private statement ::= if_statement | for_statement | function_declaration | simple_line
// An unexpected indent opens a block that ends at its own dedent, so only the indent is an error.
private unexpected_block ::= <<unexpectedIndent>> block_item* (DEDENT | <<eof>>) { pin=1 }
private statement_recover ::= !(<<atLineStart>> | STATEMENT_BREAK | DEDENT | ';')


// Simple statements

private simple_line ::= simple_statement (';' simple_statement)* (';' STATEMENT_BREAK?)?
private simple_statement ::=
    pass_statement
  | break_statement
  | continue_statement
  | return_statement
  | load_statement
  | expression_statement
private statement_end ::= <<statementEnd>>

pass_statement ::= 'pass' statement_end { pin=1 }
break_statement ::= 'break' statement_end { pin=1 }
continue_statement ::= 'continue' statement_end { pin=1 }
return_statement ::= 'return' expression? statement_end { pin=1 }

// The parser reads the left side once. An assignment operator after it changes the statement into an assignment.
expression_statement ::= expression (assignment_suffix | aug_assignment_suffix)? statement_end { pin=1 }
upper assignment_suffix ::= '=' expression { pin=1 elementType=assignment_statement }
upper aug_assignment_suffix ::= aug_operator expression { pin=1 elementType=aug_assignment_statement }
private aug_operator ::= '+=' | '-=' | '*=' | '/=' | '//=' | '%=' | '&=' | '|=' | '^=' | '<<=' | '>>='


// Load

load_statement ::= 'load' '(' load_values? ')' statement_end { pin=1 }
// StarlarkLoadParametersInspection reports a load without symbols, so the parser accepts it.
private load_values ::= !')' load_filename_item <<comma_tail load_value_start ')' load_item>>* ','? { pin=1 }
private load_filename_item ::= filename_load_value { recoverWhile=load_recover }
private load_item ::= named_load_value | string_load_value { recoverWhile=load_recover }
private load_recover ::= !(',' | open_bracket | close_bracket | STATEMENT_BREAK | load_value_start)
private load_value_start ::= STRING | IDENTIFIER &'='
filename_load_value ::= load_string
named_load_value ::= keyword_prefix load_string { pin=1 }
string_load_value ::= load_string
private load_string ::= &STRING string_literal_expression


// Compound statements

if_statement ::= 'if' single_expression colon_suite elif_clause* else_clause? { pin=1 }
private elif_clause ::= 'elif' single_expression colon_suite { pin=1 }
private else_clause ::= 'else' colon_suite { pin=1 }

for_statement ::= 'for' loop_targets 'in' expression colon_suite { pin=1 }
// A loop target is a '|' expression. So it stops before 'in', which is also a comparison operator.
private loop_targets ::= starred_operand loop_target_tuple?
left loop_target_tuple ::= ',' (starred_operand (',' starred_operand)* ','?)? { elementType=tuple_expression }

function_declaration ::= 'def' IDENTIFIER parameter_list colon_suite { pin=1 }

private colon_suite ::= <<expectColon>> suite { pin=1 }
private suite ::= block_suite | inline_statement_list
private block_suite ::= STATEMENT_BREAK statement_list { pin=1 }
statement_list ::= indented_statements | <<indentExpected>>
private indented_statements ::= INDENT block_item* (DEDENT | <<eof>>) { pin=1 }
inline_statement_list ::= inline_statements | <<statementExpected>> inline_statements? { elementType=statement_list }
private inline_statements ::= simple_line (<<atSameLine>> (simple_line | <<unexpectedStatementToken>>))*


// Parameters

parameter_list ::= '(' parameters? ')' { pin=1 }
private parameters ::= !')' parameter_item <<comma_tail parameter_start ')' parameter_item>>* ','? { pin=1 }
lambda_parameter_list ::= lambda_parameters? { elementType=parameter_list }
private lambda_parameters ::= !':' parameter_item <<comma_tail parameter_start ':' parameter_item>>* ','? { pin=1 }
private parameter_item ::= parameter { recoverWhile=parameter_recover }
private parameter_recover ::= !(',' | open_bracket | close_bracket | ':' | STATEMENT_BREAK | parameter_start)
private parameter_start ::= IDENTIFIER | '*' | '**'
private parameter ::=
    variadic_parameter
  | keyword_only_boundary
  | keyword_variadic_parameter
  | optional_parameter
  | mandatory_parameter
variadic_parameter ::= '*' IDENTIFIER
keyword_only_boundary ::= '*'
keyword_variadic_parameter ::= '**' IDENTIFIER { pin=1 }
optional_parameter ::= keyword_prefix single_expression { pin=1 }
mandatory_parameter ::= IDENTIFIER

lambda_expression ::= 'lambda' lambda_parameter_list ':' single_expression { pin=1 }


// Expressions, from the lowest priority to the highest

// A precedence cascade: each level reads the next stronger level, then zero or more tails.
// A 'left' tail wraps the node before it, so 'a - b - c' is binary(binary(a - b) - c).

// An expression can be a tuple without parentheses, as 'a, b'. A single_expression does not allow that.
// The 'if' condition uses it, because 'if 1, 2:' is not allowed.
private expression ::= single_expression tuple_expression?
left tuple_expression ::= ',' (single_expression (',' single_expression)* ','?)?

private single_expression ::= lambda_expression | conditional_level
private conditional_level ::= or_level conditional_expression?
left conditional_expression ::= 'if' or_level conditional_else single_expression { pin=1 }
private conditional_else ::= 'else'

private or_level ::= and_level or_tail*
left or_tail ::= 'or' and_level { pin=1 elementType=binary_expression }

private and_level ::= not_level and_tail*
left and_tail ::= 'and' not_level { pin=1 elementType=binary_expression }

// 'not' binds weaker than a comparison: 'not a == b' is 'not (a == b)', and 'a == not b' is an error.
private not_level ::= not_expression | comparison_level
not_expression ::= 'not' not_level { pin=1 elementType=prefix_expression }

// A chained comparison, as 'a < b < c', is not Starlark. The parser accepts it, and StarlarkUnsupportedPythonSyntaxInspection reports it.
private comparison_level ::= starred_operand comparison_tail*
left comparison_tail ::= comparison_operator bitwise_or_level { pin=1 elementType=binary_expression }
private starred_operand ::= star_expression | bitwise_or_level
private comparison_operator ::= '==' | '!=' | '<=' | '>=' | '<' | '>' | 'in' | not_in_operator
// Two tokens in one sequence would record 'not' for error messages, so 'in' is a separate rule.
private not_in_operator ::= 'not' not_in_keyword
private not_in_keyword ::= 'in'
// Unpacking, as '*x', is not Starlark. The parser accepts it, and StarlarkUnsupportedPythonSyntaxInspection reports it.
star_expression ::= '*' bitwise_or_level { pin=1 }

private bitwise_or_level ::= bitwise_xor_level bitwise_or_tail*
left bitwise_or_tail ::= '|' bitwise_xor_level { pin=1 elementType=binary_expression }

private bitwise_xor_level ::= bitwise_and_level bitwise_xor_tail*
left bitwise_xor_tail ::= '^' bitwise_and_level { pin=1 elementType=binary_expression }

private bitwise_and_level ::= shift_level bitwise_and_tail*
left bitwise_and_tail ::= '&' shift_level { pin=1 elementType=binary_expression }

private shift_level ::= additive_level shift_tail*
left shift_tail ::= ('<<' | '>>') additive_level { pin=1 elementType=binary_expression }

private additive_level ::= multiplicative_level additive_tail*
left additive_tail ::= ('+' | '-') multiplicative_level { pin=1 elementType=binary_expression }

private multiplicative_level ::= unary_level multiplicative_tail*
left multiplicative_tail ::= ('*' | '//' | '/' | '%') unary_level { pin=1 elementType=binary_expression }

private unary_level ::= prefix_expression | power_level
prefix_expression ::= ('+' | '-' | '~') unary_level { pin=1 }

// The '**' operator is not Starlark. The parser accepts it, and StarlarkUnsupportedPythonSyntaxInspection reports it.
private power_level ::= member_level power_tail?
left power_tail ::= '**' unary_level { pin=1 elementType=binary_expression }


// Postfix expressions

private member_level ::= primary_level member_tail*
private member_tail ::= qualified_reference_expression | call_expression | subscription_expression

left qualified_reference_expression ::= '.' reference_name { pin=1 elementType=reference_expression }
private reference_name ::= IDENTIFIER

left call_expression ::= argument_list
argument_list ::= '(' arguments? ')' { pin=1 }
private arguments ::= !')' argument_item <<comma_tail double_star_start ')' argument_item>>* ','? { pin=1 }
private argument_item ::= argument { recoverWhile=argument_recover }
private argument_recover ::= !(',' | close_bracket | header_colon | STATEMENT_BREAK | double_star_start)
private argument ::= star_argument_expression | named_argument_expression | argument_expression
star_argument_expression ::= ('*' | '**') single_expression { pin=1 }
named_argument_expression ::= keyword_prefix single_expression { pin=1 }
argument_expression ::= single_expression

left subscription_expression ::= '[' subscription_content subscription_end { pin=1 }
private subscription_end ::= ']'
private subscription_content ::= expression slice_suffix? | slice_suffix { recoverWhile=subscription_recover }
private subscription_recover ::= !(']' | header_colon | STATEMENT_BREAK)
upper slice_suffix ::= ':' single_expression? (':' single_expression?)? { elementType=slice_expression }


// Atoms

private primary_level ::=
    reference_expression
  | integer_literal_expression
  | float_literal_expression
  | string_literal_expression
  | none_literal_expression
  | true_literal_expression
  | false_literal_expression
  | parenthesized_expression
  | list_literal_expression
  | dict_literal_expression

reference_expression ::= IDENTIFIER
integer_literal_expression ::= INT
float_literal_expression ::= FLOAT
string_literal_expression ::= STRING | BYTES
none_literal_expression ::= 'None'
true_literal_expression ::= 'True'
false_literal_expression ::= 'False'

parenthesized_expression ::= '(' parenthesized_content ')' { pin=1 }
private parenthesized_content ::= empty_tuple | expression generator_suffix? { recoverWhile=parenthesized_recover }
private parenthesized_recover ::= !(')' | header_colon | STATEMENT_BREAK)
upper empty_tuple ::= &')' { elementType=tuple_expression }
// A generator expression is not Starlark. The parser accepts it, and StarlarkUnsupportedPythonSyntaxInspection reports it.
upper generator_suffix ::= comprehension { elementType=generator_expression }

list_literal_expression ::= '[' list_content? ']' { pin=1 }
private list_content ::= !']' list_item (&'for' list_comp_suffix | <<comma_tail expression_start ']' list_item>>* ','?) { pin=1 }
private list_item ::= single_expression { recoverWhile=list_recover }
private list_recover ::= !(',' | close_bracket | 'for' | header_colon | STATEMENT_BREAK | expression_start)
upper list_comp_suffix ::= comprehension { elementType=list_comp_expression recoverWhile=comprehension_recover }

dict_literal_expression ::= '{' dict_content? '}' { pin=1 }
private dict_content ::= !'}' dict_item (&'for' dict_comp_suffix | <<comma_tail double_star_start '}' dict_item>>* ','?) { pin=1 }
private dict_item ::= dict_entry { recoverWhile=dict_recover }
private dict_recover ::= !(',' | close_bracket | 'for' | header_colon | STATEMENT_BREAK | double_star_start)
private dict_entry ::= double_star_expression | key_value_expression
key_value_expression ::= single_expression ':' single_expression { pin=1 }
// Unpacking in a dict, as '**d', is not Starlark. The parser accepts it, and StarlarkUnsupportedPythonSyntaxInspection reports it.
double_star_expression ::= '**' bitwise_or_level { pin=1 }
upper dict_comp_suffix ::= comprehension { elementType=dict_comp_expression recoverWhile=comprehension_recover }


// Comprehensions

private comprehension ::= comprehension_for+
// The range and the condition are 'or' expressions. So an 'if' after them starts a condition, not a conditional expression.
private comprehension_for ::= 'for' loop_targets 'in' or_level comprehension_if* { pin=1 }
private comprehension_if ::= 'if' comprehension_condition { pin=1 }
private comprehension_condition ::= lambda_expression | or_level
private comprehension_recover ::= !(close_bracket | header_colon | STATEMENT_BREAK)


// Shared rules

// A ',', or a missing ',' before the next start, then an item. It stops at the close. The parameters are: start, close, item.
private meta comma_tail ::= (',' | &<<start>> missing_comma) !<<close>> <<item>> { pin=2 }
external missing_comma ::= missingComma

private keyword_prefix ::= IDENTIFIER keyword_equals
// A separate rule, because Grammar-Kit joins two tokens of a sequence into one call that ignores consumeTokenMethod.
private keyword_equals ::= '='

// Keep it in sync with primary_level, the prefix operators, 'lambda', 'not' and '*'.
private expression_start ::=
    IDENTIFIER | INT | FLOAT | STRING | BYTES | 'None' | 'True' | 'False'
  | '(' | '[' | '{' | 'lambda' | 'not' | '-' | '+' | '~' | '*'
private double_star_start ::= expression_start | '**'

// A recovery that stops at any closer must never eat an opener, or it stops at the closer of that opener.
private open_bracket ::= '(' | '[' | '{'
private close_bracket ::= ')' | ']' | '}'
// A ':' at the line end is the colon of a compound header, not part of a broken bracket content.
private header_colon ::= ':' &STATEMENT_BREAK


// Fake node types

// The parser never runs these bodies. A rule gives its node one of these types with 'elementType'.
fake assignment_statement ::= expression assignment_suffix
fake aug_assignment_statement ::= expression aug_assignment_suffix
fake binary_expression ::= single_expression single_expression
fake slice_expression ::= single_expression slice_suffix
fake generator_expression ::= single_expression comprehension
fake list_comp_expression ::= single_expression comprehension
fake dict_comp_expression ::= key_value_expression comprehension
