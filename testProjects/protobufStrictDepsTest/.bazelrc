common --enable_platform_specific_config

build:linux --extra_toolchains=@zig_sdk//toolchain:linux_amd64_gnu.2.28 --extra_toolchains=@zig_sdk//toolchain:linux_arm64_gnu.2.28 --extra_toolchains=@rules_scala_protoc_toolchains//...:all
# zig's ld.lld garbage-collects upb's linkarr section when linking protoc-gen-upb, leaving
# __start/__stop_linkarr_upb_AllExts undefined. The linker suggests -z nostart-stop-gc, but
# zig cc rejects that flag as an unsupported extension, so disable section GC entirely.
build:linux --linkopt=-Wl,--no-gc-sections --host_linkopt=-Wl,--no-gc-sections
build:macos --extra_toolchains=@zig_sdk//toolchain:darwin_amd64 --extra_toolchains=@rules_scala_protoc_toolchains//...:all

build:windows --cxxopt=/std:c++17
build:windows --host_cxxopt=/std:c++17
try-import %workspace%/user.bazelrc
