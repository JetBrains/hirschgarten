<idea-plugin>
  <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
  <dependencies>
    <module name="intellij.bazel.commons"/>
    <module name="intellij.bazel.core"/>
    <module name="intellij.bazel.importer"/>
    <module name="intellij.bazel.java.core"/>
    <module name="intellij.bazel.kotlin.common"/>
    <module name="intellij.bazel.projectview"/>
    <module name="intellij.java.debugger.impl"/>
    <module name="intellij.java.psi"/>
    <module name="intellij.kotlin.base.psi"/>
    <module name="intellij.libraries.kotlinc.analysis.api"/>
    <module name="intellij.libraries.kotlinc.analysis.api.platform.interface"/>
    <module name="intellij.libraries.kotlinc.kotlin.compiler.common"/>
    <module name="intellij.monorepo.devkit"/>
    <module name="intellij.monorepo.devkit.bazel"/>
    <module name="intellij.platform.analysis"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.core.impl"/>
    <module name="intellij.platform.debugger"/>
    <module name="intellij.platform.execution"/>
    <module name="intellij.platform.execution.impl"/>
    <module name="intellij.platform.externalSystem"/>
    <module name="intellij.platform.externalSystem.impl"/>
    <module name="intellij.platform.lang"/>
    <module name="intellij.platform.projectModel"/>
  </dependencies>
  <!-- endregion -->
  <extensions defaultExtensionNs="org.jetbrains.bazel">
    <hotSwapHook implementation="com.intellij.bazel.devkit.monorepo.hotswap.MonorepoDevkitHotSwapHook"/>
  </extensions>

  <extensions defaultExtensionNs="com.intellij">
    <multipleRunLocationsProvider implementation="com.intellij.bazel.devkit.monorepo.run.MonorepoBazelContainingTargetsLocationsProvider"/>
    <runLineMarkerContributor
      implementationClass="com.intellij.bazel.devkit.monorepo.run.MonorepoStarlarkRunLineMarkerContributor"
      language="Starlark"
    />
    <postStartupActivity implementation="com.intellij.bazel.devkit.monorepo.run.MonorepoProjectViewStartupActivity"/>
    <postStartupActivity implementation="com.intellij.bazel.devkit.monorepo.sync.UnlinkedProjectNotificationDisabler"/>
  </extensions>
</idea-plugin>