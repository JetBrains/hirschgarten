<idea-plugin>
  <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
  <dependencies>
    <module name="intellij.bazel.backend"/>
    <module name="intellij.bazel.commons"/>
    <module name="intellij.bazel.core"/>
    <module name="intellij.bazel.java.common"/>
    <module name="intellij.bazel.java.core"/>
    <module name="intellij.bazel.protobuf"/>
    <module name="intellij.devkit.core"/>
    <module name="intellij.java.debugger.impl"/>
    <module name="intellij.java.execution"/>
    <module name="intellij.java.execution.impl"/>
    <module name="intellij.java.impl"/>
    <module name="intellij.java.psi"/>
    <module name="intellij.libraries.gson"/>
    <module name="intellij.libraries.protobuf"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.core.ui"/>
    <module name="intellij.platform.debugger"/>
    <module name="intellij.platform.execution"/>
    <module name="intellij.platform.execution.impl"/>
    <module name="intellij.platform.externalSystem.impl"/>
    <module name="intellij.platform.ide"/>
    <module name="intellij.platform.ide.core"/>
    <module name="intellij.platform.lang"/>
    <module name="intellij.platform.lang.core"/>
    <module name="intellij.platform.projectModel"/>
    <module name="intellij.platform.smRunner"/>
    <module name="intellij.platform.testRunner"/>
  </dependencies>
  <!-- endregion -->

  <extensionPoints>
    <extensionPoint qualifiedName="org.jetbrains.bazel.jetBrainsTestRunnerDetector"
                    interface="org.jetbrains.bazel.intellij.JetBrainsTestRunner$Detector"
                    dynamic="true"/>
  </extensionPoints>

  <extensions defaultExtensionNs="org.jetbrains.bazel">
    <runHandlerProvider
      implementation="org.jetbrains.bazel.intellij.IntellijPluginRunHandlerProvider"
      order="before JvmRunHandlerProvider"
    />
    <runHandlerProvider
      implementation="org.jetbrains.bazel.intellij.IntellijDevLaunchRunHandlerProvider"
      order="before JvmRunHandlerProvider"
    />
    <targetKindProvider implementation="org.jetbrains.bazel.intellij.IntelliJMonorepoBazelRules"/>
    <jvmTestRunnerExtension implementation="org.jetbrains.bazel.intellij.JetBrainsTestRunnerExtension"/>
    <jvmTestRerunExtension implementation="org.jetbrains.bazel.intellij.JetBrainsTestRerunExtension"/>
    <jvmTestFilterExtension implementation="org.jetbrains.bazel.intellij.JetBrainsTestFilterExtension"/>
    <runHandlerProvider
      id="JetBrainsTestSuiteHandlerProvider"
      implementation="org.jetbrains.bazel.intellij.JetBrainsTestSuiteHandler$JetBrainsTestSuiteHandlerProvider"
    />
  </extensions>
  <extensions defaultExtensionNs="com.intellij">
    <stepsBeforeRunProvider implementation="org.jetbrains.bazel.intellij.BuildPluginBeforeRunTaskProvider"/>
    <stepsBeforeRunProvider implementation="org.jetbrains.bazel.intellij.CopyPluginToSandboxBeforeRunTaskProvider"/>
    <programRunner implementation="org.jetbrains.bazel.intellij.IntellijPluginDebuggerRunner"/>
    <programRunner implementation="org.jetbrains.bazel.intellij.IntellijDevLaunchDebugRunner"/>
  </extensions>
</idea-plugin>
