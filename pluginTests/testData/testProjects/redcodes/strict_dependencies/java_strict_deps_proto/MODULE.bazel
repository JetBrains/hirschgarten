module(
    name = "bazel_worker_jps",
    version = "0",
)

bazel_dep(name = "bazel_worker_api", version = "0.0.6")
bazel_dep(name = "protobuf", version = "33.4")
bazel_dep(name = "rules_jvm_external", version = "6.5")
bazel_dep(name = "rules_java", version = "8.3.0")
bazel_dep(name = "cc_false_toolchain", version = "local")
bazel_dep(name = "false_launcher", version = "local")

# The .bazelrc selects the prebuilt protoc, so the build compiles no C++ and needs no real C++ toolchain.
single_version_override(
    module_name = "protobuf",
    version = "33.4",
)

single_version_override(
    module_name = "bazel_worker_api",
    version = "0.0.6",
)

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    artifacts = [
        "com.google.protobuf:protobuf-java:4.28.3",
        "com.google.protobuf:protobuf-java-util:4.28.3",
    ],
    repositories = ["https://cache-redirector.jetbrains.com/repo1.maven.org/maven2"],
)
use_repo(maven, "maven")
