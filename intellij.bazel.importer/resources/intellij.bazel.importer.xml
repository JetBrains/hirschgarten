<idea-plugin visibility="public">
  <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
  <dependencies>
    <module name="intellij.bazel.commons"/>
    <module name="intellij.bazel.connector"/>
    <module name="intellij.bazel.projectview"/>
    <module name="intellij.bazel.protobuf"/>
    <module name="intellij.libraries.bazel.aspect.sdk"/>
    <module name="intellij.platform.backend"/>
  </dependencies>
  <!-- endregion -->

  <extensionPoints>
    <extensionPoint
      dynamic="true"
      interface="org.jetbrains.bazel.sync.ProjectSyncHook"
      qualifiedName="org.jetbrains.bazel.projectSyncHook"
    />
    <extensionPoint
      dynamic="true"
      interface="org.jetbrains.bazel.sync.ProjectPreSyncHook"
      qualifiedName="org.jetbrains.bazel.projectPreSyncHook"
    />
    <extensionPoint
      dynamic="true"
      interface="org.jetbrains.bazel.sync.ProjectPostSyncHook"
      qualifiedName="org.jetbrains.bazel.projectPostSyncHook"
    />
    <!-- dynamic="false" because of the caching in the init block of TargetKindService  -->
    <extensionPoint
      dynamic="false"
      interface="org.jetbrains.bazel.sync.workspace.targetKind.TargetKindProvider"
      qualifiedName="org.jetbrains.bazel.targetKindProvider"
    />
    <extensionPoint
      dynamic="true"
      interface="org.jetbrains.bazel.sync.workspace.languages.LanguagePlugin"
      qualifiedName="org.jetbrains.bazel.languagePlugin"
    />
    <extensionPoint
      dynamic="true"
      interface="org.jetbrains.bazel.sync.workspace.importer.BazelWorkspaceImporter"
      qualifiedName="org.jetbrains.bazel.syncWorkspaceImporter"
    />
    <extensionPoint qualifiedName="org.jetbrains.bazel.indexAdditionalFilesContributor"
                    interface="org.jetbrains.bazel.workspace.indexAdditionalFiles.IndexAdditionalFilesContributor"
                    dynamic="true"
    />
    <extensionPoint qualifiedName="org.jetbrains.bazel.workspaceTypeContributor"
                    interface="org.jetbrains.bazel.sync.workspace.persistence.WorkspaceTypeContributor"
                    dynamic="false"
    />
  </extensionPoints>

  <extensions defaultExtensionNs="org.jetbrains.bazel">
    <projectSyncHook implementation="org.jetbrains.bazel.sync.hooks.PathSyncHook"/>
    <targetKindProvider implementation="org.jetbrains.bazel.sync.workspace.targetKind.GenericBazelRules" order="last"/>

    <workspaceTypeContributor implementation="org.jetbrains.bazel.sync.workspace.persistence.DefaultWorkspaceTypeContributor"/>
  </extensions>

  <extensions defaultExtensionNs="com.intellij">
    <workspaceModel.fileIndexContributor
      implementation="org.jetbrains.bazel.workspace.BazelProjectDirectoriesWorkspaceFileIndexContributor"
    />
    <projectService serviceInterface="org.jetbrains.bazel.sync.workspace.persistence.WorkspaceSnapshotService"
                    serviceImplementation="org.jetbrains.bazel.sync.workspace.persistence.mvstore.DefaultWorkspaceSnapshotService"/>
  </extensions>
</idea-plugin>
