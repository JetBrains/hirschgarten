module(
    name = "rules_jvm",  # Hack: make statements like `load("@rules_jvm//:jvm.bzl", "jvm_library")` work
)

http_jar = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_jar")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

# dependency on the new aspect's sdk
bazel_dep(name = "intellij_aspect_sdk")
git_override(
    module_name = "intellij_aspect_sdk",
    commit = "a3f8ec94e1a9ce26078bf3143a4005580da3d8e6",
    remote = "https://github.com/JetBrains/intellij-aspect.git",
)

bazel_dep(
    name = "rules_kotlin",
    version = "2.4.0",
)

register_toolchains(
    "//:kotlin_toolchain",
)

bazel_dep(name = "rules_java", version = "9.6.1")
bazel_dep(name = "rules_jvm_external", version = "7.0")
bazel_dep(name = "rules_python", version = "2.1.0")

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    artifacts = [
        "com.fasterxml.jackson.dataformat:jackson-dataformat-xml:2.19.0",
        # Test-only, used by //pluginTests
        "org.junit.jupiter:junit-jupiter:5.14.4",
        "org.junit.platform:junit-platform-launcher:1.14.4",
        "org.junit.vintage:junit-vintage-engine:5.14.4",
        "io.kotest:kotest-assertions-core-jvm:5.5.4",
        "org.mockito:mockito-core:5.19.0",
        "org.jetbrains.kotlinx:kotlinx-coroutines-test:1.10.2",
        "org.jetbrains.kotlin:kotlin-test:2.4.20",
        "net.java.dev.jna:jna:5.19.1",
        "org.jetbrains.pty4j:pty4j:0.13.12",
        "org.assertj:assertj-core:4.0.0-M1",
    ],
    excluded_artifacts = [
        "org.jetbrains.kotlin:kotlin-stdlib",
        "org.jetbrains.kotlin:kotlin-stdlib-common",
        "org.jetbrains.kotlin:kotlin-stdlib-jdk7",
        "org.jetbrains.kotlin:kotlin-stdlib-jdk8",
        "org.jetbrains.kotlin:kotlin-reflect",
        "org.jetbrains.kotlinx:kotlinx-coroutines-core",
        "org.jetbrains.kotlinx:kotlinx-coroutines-core-jvm",
        "org.jetbrains.kotlinx:kotlinx-coroutines-jdk8",
        "org.jetbrains:annotations",
        "net.java.dev.jna:jna-platform",
    ],
    lock_file = "//:maven_install.json",
    repositories = [
        "https://cache-redirector.jetbrains.com/maven-central",
    ],
)
use_repo(maven, "maven")

