<idea-plugin>
  <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
  <dependencies>
    <plugin id="com.intellij.clion"/>
    <module name="intellij.bazel.backend"/>
    <module name="intellij.bazel.commons"/>
    <module name="intellij.bazel.core"/>
    <module name="intellij.cidr.projectModel"/>
    <module name="intellij.cidr.psi.base"/>
    <module name="intellij.cidr.util.execution"/>
    <module name="intellij.cidr.workspaceModel"/>
    <module name="intellij.platform.analysis"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.lang"/>
    <module name="intellij.platform.projectModel"/>
    <module name="intellij.platform.workspace.jps"/>
  </dependencies>
  <!-- endregion -->

  <extensions defaultExtensionNs="org.jetbrains.bazel">
    <workspaceTypeContributor implementation="org.jetbrains.bazel.clion.sync.CcWorkspaceTypeContributor"/>
    <languageClassProvider implementation="org.jetbrains.bazel.clion.sync.CcLanguageClassProvider"/>
    <bazelRuleSetProvider implementation="org.jetbrains.bazel.clion.sync.CcRuleSetProvider"/>
    <targetKindProvider implementation="org.jetbrains.bazel.clion.sync.CcTargetKindProvider"/>
    <languagePlugin implementation="org.jetbrains.bazel.clion.sync.CcLanguagePlugin"/>
    <syncWorkspaceImporter implementation="org.jetbrains.bazel.clion.workspace.CcWorkspaceImporter"/>
  </extensions>

  <extensions defaultExtensionNs="cidr.projectModel">
    <ocWorkspaceStorageCustomizer implementation="org.jetbrains.bazel.clion.workspace.CcWorkspaceStorageCustomizer"/>
  </extensions>

</idea-plugin>
